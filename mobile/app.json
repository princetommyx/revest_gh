{
  "expo": {
    "sdkVersion": "57.0.0",
    "name": "Revesta",
    "slug": "revesta-mobile",
    "scheme": "revesta",
    "version": "1.0.15",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.revesta.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Revesta shares your location with the disposer so they can track your pickup live, including while the app is in the background during an active job.",
        "NSLocationWhenInUseUsageDescription": "Revesta uses your location to find nearby pickups and show your position on the map.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "AIzaSyA1nWxJMGcBK7lFZBmy_8hVZNm3kqqGXZA"
      }
    },
    "android": {
      "versionCode": 16,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.revesta.mobile",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA1nWxJMGcBK7lFZBmy_8hVZNm3kqqGXZA"
        }
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you upload waste items.",
          "cameraPermission": "The app accesses your camera to let you take photos of waste items."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Revesta shares your location with the disposer so they can track your pickup live, including while the app is in the background during an active job.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "kotlinVersion": "2.1.20"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "runtimeVersion": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "8b99f6ee-5ad2-4b23-a14a-6b9fdf4ac4ad"
      }
    },
    "owner": "tommytechsxs-team"
  }
}
